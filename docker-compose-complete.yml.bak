version: "3.8"

services:
    # Your custom web frontend
    web:
        image: mowsen/jitsi-meet:latest
        build:
            context: .
            dockerfile: Dockerfile.simple
        container_name: jitsi-web-custom
        restart: unless-stopped
        ports:
            - "8000:80"
        environment:
            - PUBLIC_URL=http://localhost:8000
        networks:
            - meet.avaxcoolyeti.com
        depends_on:
            - prosody

    # Prosody XMPP server
    prosody:
        image: jitsi/prosody:stable-9584
        container_name: jitsi-prosody
        restart: unless-stopped
        ports:
            - "5280:5280"
        expose:
            - "5222"
            - "5347"
        environment:
            - ENABLE_AUTH=0
            - ENABLE_GUESTS=1
            - XMPP_DOMAIN=meet.avaxcoolyeti.com
            - XMPP_AUTH_DOMAIN=auth.meet.avaxcoolyeti.com
            - XMPP_MUC_DOMAIN=muc.meet.avaxcoolyeti.com
            - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.avaxcoolyeti.com
            - JICOFO_AUTH_USER=focus
            - JICOFO_AUTH_PASSWORD=jicofopass
            - JVB_AUTH_USER=jvb
            - JVB_AUTH_PASSWORD=jvbpass
        networks:
            - meet.avaxcoolyeti.com

    # Jicofo (conference focus)
    jicofo:
        image: jitsi/jicofo:stable-9584
        container_name: jitsi-jicofo
        restart: unless-stopped
        depends_on:
            - prosody
        environment:
            - ENABLE_AUTH=0
            - XMPP_DOMAIN=meet.avaxcoolyeti.com
            - XMPP_AUTH_DOMAIN=auth.meet.avaxcoolyeti.com
            - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.avaxcoolyeti.com
            - XMPP_SERVER=prosody
            - JICOFO_AUTH_USER=focus
            - JICOFO_AUTH_PASSWORD=jicofopass
            - JVB_BREWERY_MUC=jvbbrewery
        networks:
            - meet.avaxcoolyeti.com

    # JVB (video bridge)
    jvb:
        image: jitsi/jvb:stable-9584
        container_name: jitsi-jvb
        restart: unless-stopped
        depends_on:
            - prosody
        ports:
            - "10000:10000/udp"
        environment:
            - XMPP_AUTH_DOMAIN=auth.meet.avaxcoolyeti.com
            - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.avaxcoolyeti.com
            - XMPP_SERVER=prosody
            - JVB_AUTH_USER=jvb
            - JVB_AUTH_PASSWORD=jvbpass
            - JVB_BREWERY_MUC=jvbbrewery
            - JVB_PORT=10000
            - JVB_STUN_SERVERS=stun.l.google.com:19302
        networks:
            - meet.avaxcoolyeti.com

networks:
    meet.avaxcoolyeti.com:
        driver: bridge

# Simple Dockerfile for pre-built Jitsi Meet
FROM nginx:alpine

# Copy pre-built files (these should already exist from local build)
COPY libs/ /usr/share/nginx/html/libs/
COPY css/ /usr/share/nginx/html/css/
COPY images/ /usr/share/nginx/html/images/
COPY sounds/ /usr/share/nginx/html/sounds/
COPY fonts/ /usr/share/nginx/html/fonts/
COPY lang/ /usr/share/nginx/html/lang/
COPY static/ /usr/share/nginx/html/static/
COPY *.html /usr/share/nginx/html/
COPY *.js /usr/share/nginx/html/
COPY *.json /usr/share/nginx/html/
COPY manifest.json /usr/share/nginx/html/
COPY pwa-worker.js /usr/share/nginx/html/
COPY config.js /usr/share/nginx/html/
COPY interface_config.js /usr/share/nginx/html/

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Expose VERSION to be fetched by the client
COPY VERSION /usr/share/nginx/html/VERSION

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
